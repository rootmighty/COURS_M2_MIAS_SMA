# Copiez ce fichier en .env puis renseignez votre clé :
#     cp .env.example .env
# Ne commitez JAMAIS le fichier .env (il contient votre clé personnelle).

NVIDIA_API_KEY=nvapi-xxx

# Modèle utilisé dans tout le cours (identifiant exact depuis build.nvidia.com)
# NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Effort de raisonnement : low (rapide, économe) | medium | high
NVIDIA_REASONING_EFFORT=low

# Optionnel : autre modèle pour la démo 01b_modele_thinking.py
# (si vide, 01b utilise NVIDIA_MODEL)
NVIDIA_THINKING_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Modèle d'embedding multilingue de l'API NVIDIA (https://build.nvidia.com)
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b

